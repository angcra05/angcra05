// Operation ECHOLEAK — KQL reference, adapted from analyst screenshots
// Run these examples separately; not newly executed for publication.

// Copilot file search/read activity
CopilotAudit_CL
| where RunId == "el--17-20260920"
| where UserId == "emily.chen@cormorantcapital.com"
| where InteractionType == "ToolCall"
| project TimeGenerated, ToolName, ToolParameters, SensitivityLabels
| order by TimeGenerated asc

